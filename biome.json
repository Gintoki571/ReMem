{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 110
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "files": {
    "includes": [
      "src/types.ts",
      "src/store.ts",
      "src/store.test.ts",
      "src/embedder.ts",
      "src/embedder.test.ts",
      "src/recall.ts",
      "src/recall.test.ts",
      "src/graph.ts",
      "src/graph.test.ts",
      "src/remem.ts",
      "src/remem.test.ts",
      "src/index.ts",
      "src/cli/**",
      "scripts/**",
      "test/**",
      "src/model-availability.ts"
    ]
  }
}
