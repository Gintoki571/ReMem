{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "incremental": true,
    "types": ["node"]
  },
  "include": ["src/types.ts", "src/store.ts", "src/store.test.ts", "src/index.ts", "src/embedder.ts", "src/embedder.test.ts", "src/recall.ts", "src/recall.test.ts", "src/graph.ts", "src/graph.test.ts", "src/remem.ts", "src/remem.test.ts"],
  "exclude": ["node_modules", "dist", "legacy"]
}
