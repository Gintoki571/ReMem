# LLM Configuration (choose one option)

# Option 1: OpenAI API (paid)
# OPENAI_API_KEY=sk-your-key-here

# Option 2: LM Studio (free, local)
# Start LM Studio, load a model, enable the server, then use:
OPENAI_API_KEY=lm-studio
OPENAI_BASE_URL=http://localhost:1234/v1
LLM_MODEL=local-model

# For embeddings with LM Studio, you need a model that supports embeddings
# or disable embeddings by setting this to false:
ENABLE_EMBEDDINGS=false
