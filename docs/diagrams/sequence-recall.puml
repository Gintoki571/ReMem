@startuml
title recall flow
actor Agent
participant "CLI/MCP" as edge
participant "RecallEngine" as engine
participant "store" as store
participant "graph" as graph
Agent -> edge: recall(text, k)
edge -> engine: recall(query)
engine -> store: list\nallowed ids
engine -> store: fts_search(text)
store --> engine: fts ids
engine -> engine: embed query
engine -> store: knn(qvec)
store --> engine: vector ids
loop per seed mid (top fused fts+vector)
  engine -> graph: neighbors(mid)
end
graph --> engine: graph ids
engine -> engine: RRF fuse\nfts + vector + graph
engine -> engine: final_score\nimportance x recency
engine -> engine: rank::tag_boost
engine -> engine: pack by budget
engine -> engine: apply floor
engine --> edge: hits[]
edge --> Agent: hits[]
@enduml
