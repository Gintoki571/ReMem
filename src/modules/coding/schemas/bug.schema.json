{
    "name": "add_bug",
    "description": "Track a bug or issue in the codebase",
    "properties": {
        "name": {
            "type": "string",
            "description": "Short summary of the bug",
            "required": true
        },
        "status": {
            "type": "string",
            "description": "Current status of the bug",
            "enum": [
                "open",
                "in_progress",
                "resolved",
                "closed"
            ],
            "required": true
        },
        "severity": {
            "type": "string",
            "description": "How serious is the bug",
            "enum": [
                "low",
                "medium",
                "high",
                "critical"
            ]
        },
        "description": {
            "type": "string",
            "description": "Detailed description and reproduction steps"
        },
        "fix_description": {
            "type": "string",
            "description": "How it was fixed (if resolved)"
        },
        "affected_file": {
            "type": "string",
            "description": "The file where the bug was found",
            "relationship": {
                "edgeType": "affects",
                "description": "Bug affects specific file"
            }
        }
    }
}