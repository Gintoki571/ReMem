{
    "name": "add_task",
    "description": "Track a development task or to-do item",
    "properties": {
        "name": {
            "type": "string",
            "description": "Title of the task",
            "required": true
        },
        "status": {
            "type": "string",
            "description": "Current status of the task",
            "enum": [
                "todo",
                "in_progress",
                "done",
                "blocked"
            ],
            "required": true
        },
        "priority": {
            "type": "string",
            "description": "Task priority level",
            "enum": [
                "low",
                "medium",
                "high"
            ]
        },
        "description": {
            "type": "string",
            "description": "Details of what needs to be done"
        },
        "related_file": {
            "type": "string",
            "description": "File this task is related to",
            "relationship": {
                "edgeType": "relates_to",
                "description": "Task relates to file"
            }
        }
    }
}